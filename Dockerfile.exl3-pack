# Dockerfile.exl3-pack — EXL3 pack builder (convert + repack + pipeline) for GB10 / b12x
#
# General-purpose image for building EXL3 MoE packs on this workspace.
# Model geometry is auto-detected from source config.json — no per-model
# config needed for standard MoE architectures (MiMo-V2, DeepSeek-V4,
# Kimi-K3, Qwen-MoE, etc.).
#
# Subcommands (see pack-build help):
#   pipeline   src work exl3-out v1-out bits codebook [convert-args...]
#              Full convert -> repack pipeline with progress tracking.
#   convert    src out work bits codebook [convert-args...]
#              exllamav3 convert_model with progress tracking.
#   repack     pack v1-out bits [repack-args...]
#              b12x exl3-v1 repack with progress tracking.
#   detect     src
#              Auto-detect model geometry from source config.json.
#   status     [--json] [--watch [INTERVAL]] [status-file]
#              Read or watch the progress status file.
#
# Observability:
#   Progress written atomically to /work/.pack-status.json (JSON).
#   pack-build status --watch shows live layer progress and ETA.
#   pack-build status --watch from a second terminal on the host:
#     docker exec <container> pack-build status --watch
#
# Build from the repository root:
#   docker build -f Dockerfile.exl3-pack -t exl3-pack:cu13.0 .
#
# Run (mount the source model read-only + work/output dirs):
#   docker run --rm --gpus all --name pack-mimo \
#     -v /nas-1/models:/models:ro \
#     -v /nas-1/fes-projects/exl3-mimo-build:/work \
#     exl3-pack:cu13.0 \
#     pipeline /models/mimo/mimo-v2.6-flash-rl /work/work-k3 \
#              /work/mimo-mcg-k3 /work/mimo-exl3-v1 3 mcg
#
#   # Monitor progress from a second terminal:
#   docker exec pack-mimo pack-build status --watch
#
#   # Single stage:
#   docker run --rm --gpus all \
#     -v /nas-1/fes-projects/exl3-mimo-build:/work \
#     exl3-pack:cu13.0 \
#     repack /work/mimo-mcg-k3 /work/mimo-exl3-v1 3 --self-check
#
#   # Inspect a new model:
#   docker run --rm \
#     -v /nas-1/models:/models:ro \
#     exl3-pack:cu13.0 \
#     detect /models/deepseek-v4.1
#
# Base image: the runtime image carries torch 2.13.0+cu130, b12x 1.3.0
# (exl3-v1 reader/writer), and the CUDA toolchain. Override BASE_IMAGE
# for a different torch/cu13 base.
#
# Codebook/rate: the b12x `exl3-v1` path executes `mcg` at K3-K6 and
# `lut_e4m3` at K2-K4 (MCG K2 is rejected at runtime). exllamav3 can emit
# `mul1`/`mcg`/`3inst` — use `-cb mcg` for b12x.
# See mods/exl3-mimo/EXL3_MIMO_PACK.md.

ARG BASE_IMAGE=vllm-node-b12x:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive

# --- exllamav3 (FES aarch64 / cu13.0 build: includes MiMoV2 arch + exllamav3_ext)
# Pinned by URL + sha256; swap for a newer release tag as needed.
ARG EXLLAMAV3_WHEEL_URL=https://github.com/Fulton-Engineering-Services/dgx-spark-wheels/releases/download/exllamav3-v1.5.1-cu13.0/exllamav3-1.5.1%2Bcu13.0torch2.13.glibc239-cp312-cp312-linux_aarch64.whl
ARG EXLLAMAV3_WHEEL_SHA256=e993d5763d9d94e42e04bc20087f458b75d0df0c9afe4d85bfca53ee196027d9
ARG EXLLAMAV3_WHEEL=exllamav3-1.5.1+cu13.0torch2.13.glibc239-cp312-cp312-linux_aarch64.whl
RUN set -eux; \
    curl -fsSL -o /tmp/${EXLLAMAV3_WHEEL} "${EXLLAMAV3_WHEEL_URL}"; \
    echo "${EXLLAMAV3_WHEEL_SHA256}  /tmp/${EXLLAMAV3_WHEEL}" | sha256sum -c -; \
    python3 -m pip install --no-deps --break-system-packages /tmp/${EXLLAMAV3_WHEEL} \
      || python3 -m pip install --no-deps /tmp/${EXLLAMAV3_WHEEL}; \
    rm -f /tmp/${EXLLAMAV3_WHEEL}

# --- pack-build tooling
COPY mods/exl3-mimo/pack-build/ /opt/exl3-pack/
COPY mods/exl3-mimo/EXL3_MIMO_PACK.md /opt/exl3-pack/EXL3_MIMO_PACK.md
RUN chmod +x /opt/exl3-pack/pack-build \
  && chmod +x /opt/exl3-pack/pack-monitor.sh \
  && chmod +x /opt/exl3-pack/pack-pipeline.sh

# --- entrypoint
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'exec /opt/exl3-pack/pack-build "$@"' \
  > /usr/local/bin/exl3-pack; \
  chmod +x /usr/local/bin/exl3-pack

WORKDIR /work
ENV PACK_STATUS_FILE=/work/.pack-status.json \
    PACK_MONITOR_INTERVAL=10

ENTRYPOINT ["/usr/local/bin/exl3-pack"]
CMD ["help"]

LABEL org.opencontainers.image.title="EXL3 pack builder (convert + repack + pipeline)" \
      org.opencontainers.image.description="exllamav3 EXL3 quantizer + b12x exl3-v1 repack for DGX Spark / GB10. Model-agnostic geometry detection. Progress tracking with ETA." \
      org.opencontainers.image.source="https://github.com/Fulton-Engineering-Services/spark-vllm-docker"