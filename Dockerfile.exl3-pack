# Dockerfile.exl3-pack — EXL3 pack builder (convert + repack + assemble) for GB10 / b12x
#
# One generalized image for every model: the shared library (mods/exl3-pack)
# is installed as a package, and each per-model spec directory
# (mods/<model>/pack-build/) is baked under /opt/exl3-specs/<model>/.
# Model geometry is auto-detected from the source config.json, so a new
# standard MoE model onboards by adding only a thin spec dir — no logic change.
#
# Subcommands (see `exl3-pack help`):
#   detect <src>
#   convert <src> <out> <work>       (codebook/bits from the model spec)
#   repack  <pack> <v1-out>
#   assemble <src> <pack> <serve-out>
#   pipeline <src> <work> <exl3-out> <v1-out>
#   plan                                  (dry-run: resolved paths + mounts)
#   status [--json] [--watch [INTERVAL]]
#   selftest                              (in-image integration import check)
#
# Output goes to the NAS; node-local NVMe is used only for the working set.
#
# Build from the repository root:
#   docker build -f Dockerfile.exl3-pack -t exl3-pack:cu13.0 .
#
# Run (mount the node-local source + NAS read-write):
#   docker run --rm --gpus all --name pack-pro \
#     -v /opt/llm:/opt/llm:rw \
#     -v /nas-1:/nas-1:rw \
#     exl3-pack:cu13.0 \
#     --model mimo-v2.6-pro-rl-uncensored pipeline \
#       /opt/llm/staging/mimo-v2.6-pro-rl-uncensored \
#       /opt/llm/fes-projects/exl3-mimo-build/pro-work \
#       /opt/llm/fes-projects/exl3-mimo-build/pro-mcg \
#       /nas-1/models/mimo/mimo-v2.6-pro-rl-uncensored-exl3-v1
#
# Base image: the runtime image carries torch 2.13.0+cu130, b12x 1.3.0
# (exl3-v1 reader/writer), and the CUDA toolchain. Override BASE_IMAGE
# for a different torch/cu13 base.
#
# See mods/exl3-pack/README.md and mods/exl3-pack/NEW_MODEL.md.

ARG BASE_IMAGE=vllm-node-b12x:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive

# --- exllamav3 (FES aarch64 / cu13.0 build: includes MiMoV2 arch + exllamav3_ext)
# Pinned by URL + sha256; swap for a newer release tag as needed.
ARG EXLLAMAV3_WHEEL_URL=https://github.com/Fulton-Engineering-Services/dgx-spark-wheels/releases/download/exllamav3-v1.5.1-cu13.0/exllamav3-1.5.1%2Bcu13.0torch2.13.glibc239-cp312-cp312-linux_aarch64.whl
ARG EXLLAMAV3_WHEEL_SHA256=e993d5763d9d94e42e04bc20087f458b75d0df0c9afe4d85bfca53ee196027d9
ARG EXLLAMAV3_WHEEL=exllamav3-1.5.1+cu13.0torch2.13.glibc239-cp312-cp312-linux_aarch64.whl
RUN set -eux; \
    curl -fsSL -o /tmp/${EXLLAMAV3_WHEEL} "${EXLLAMAV3_WHEEL_URL}"; \
    echo "${EXLLAMAV3_WHEEL_SHA256}  /tmp/${EXLLAMAV3_WHEEL}" | sha256sum -c -; \
    python3 -m pip install --no-deps --break-system-packages /tmp/${EXLLAMAV3_WHEEL} \
      || python3 -m pip install --no-deps /tmp/${EXLLAMAV3_WHEEL}; \
    rm -f /tmp/${EXLLAMAV3_WHEEL}; \
    python3 -m pip install --break-system-packages marisa_trie \
      || python3 -m pip install marisa_trie

# --- shared library (importable via PYTHONPATH; no build backend needed)
COPY mods/exl3-pack/src /opt/exl3-pack/src
COPY mods/exl3-pack/tools /opt/exl3-pack/tools
COPY mods/exl3-pack/pyproject.toml /opt/exl3-pack/pyproject.toml
COPY mods/exl3-pack/stubs /opt/exl3-pack/stubs
COPY mods/exl3-pack/tests /opt/exl3-pack/tests
RUN python3 -m pip install --break-system-packages mypy || python3 -m pip install mypy

# --- per-model specs baked under the specs root
COPY mods/mimo-v2.6-flash-rl-uncensored/pack-build /opt/exl3-specs/mimo-v2.6-flash-rl-uncensored/pack-build
COPY mods/mimo-v2.6-pro-rl-uncensored/pack-build /opt/exl3-specs/mimo-v2.6-pro-rl-uncensored/pack-build
COPY mods/exl3-pack/node-model-map.json /opt/exl3-specs/node-model-map.json
RUN chmod +x /opt/exl3-specs/*/pack-build/pack-build || true

ENV EXL3_SPECS_ROOT=/opt/exl3-specs \
    EXL3_NODE_MODEL_MAP=/opt/exl3-specs/node-model-map.json \
    PYTHONPATH=/opt/exl3-pack/src \
    PACK_STATUS_FILE=/work/.pack-status.json

WORKDIR /work
ENTRYPOINT ["python3", "-m", "exl3pack.cli"]
CMD ["help"]

LABEL org.opencontainers.image.title="EXL3 pack builder (shared lib + per-model specs)" \
      org.opencontainers.image.description="exllamav3 EXL3 quantizer + b12x exl3-v1 repack for DGX Spark / GB10. Model-agnostic geometry detection; shared library, thin per-model specs, node-local source + NAS output." \
      org.opencontainers.image.source="https://github.com/Fulton-Engineering-Services/spark-vllm-docker"
